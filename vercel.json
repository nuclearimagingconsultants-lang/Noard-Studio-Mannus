{
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/:path((?!api(?:/|$)|manus-storage(?:/|$)|assets(?:/|$)|.*\\.(?:js|mjs|css|map|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|eot|json|pdf|mp4|webm)$).*)",
      "destination": "/index.html"
    }
  ]
}
